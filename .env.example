############################
# Public URLs
############################
# Where the Next.js app is reachable from the browser.
APP_URL=https://zotion.example.com

# Where the self-hosted Convex backend is reachable from the browser.
# In Dokploy: point a second domain at the convex-backend service, port 3210.
NEXT_PUBLIC_CONVEX_URL=https://convex.example.com
# Convex HTTP actions origin (port 3211). Defaults to NEXT_PUBLIC_CONVEX_URL.
CONVEX_SITE_URL=https://convex.example.com

############################
# Better Auth (self-hosted)
############################
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to "false" to manage the auth tables yourself instead of on boot.
AUTH_AUTO_MIGRATE=true

############################
# Postgres
############################
POSTGRES_USER=zotion
POSTGRES_PASSWORD=
# Bootstrap database only. Convex creates its own database named after
# CONVEX_INSTANCE_NAME, and Better Auth uses AUTH_DATABASE_NAME.
POSTGRES_DB=postgres
AUTH_DATABASE_NAME=zotion_auth

############################
# Convex backend
############################
CONVEX_INSTANCE_NAME=zotion
# openssl rand -hex 32
CONVEX_INSTANCE_SECRET=
CONVEX_BACKEND_VERSION=latest
# docker compose exec convex-backend ./generate_admin_key.sh
# Quote it: the key contains a | character.
CONVEX_SELF_HOSTED_ADMIN_KEY=""

# Only needed when running `npx convex deploy` / `dev` from your machine.
CONVEX_SELF_HOSTED_URL=http://localhost:3210

############################
# MinIO / S3-compatible storage
############################
S3_ENDPOINT=http://minio:9000
S3_BUCKET=zotion
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# 50 MB
MAX_UPLOAD_SIZE=52428800
