{
  "name": "notion-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "screenshots": "npm run seed:demo && playwright test --config=playwright.screenshots.config.ts && node scripts/update-readme-gallery.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy -y",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@blocknote/code-block": "^0.52.1",
    "@blocknote/core": "^0.52.1",
    "@blocknote/mantine": "^0.52.1",
    "@blocknote/react": "^0.52.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.0",
    "emoji-picker-react": "^4.7.10",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.4",
    "react-dropzone": "^19.1.1",
    "react-textarea-autosize": "^8.5.3",
    "react-use-measure": "^2.1.7",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
