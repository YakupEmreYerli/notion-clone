#!/usr/bin/env bash
# Zotion — refreshes the README screenshot gallery on UI-touching commits.
#
# Install once per clone:  npm run hooks:install
# Skip a single commit:    ZOTION_SKIP_SCREENSHOTS=1 git commit ...
set -euo pipefail

if [ "${ZOTION_SKIP_SCREENSHOTS:-0}" = "1" ]; then
  echo "- screenshot step skipped (ZOTION_SKIP_SCREENSHOTS=1)"
  exit 0
fi

# Only paths that can change what the app looks like. Commits touching docs,
# convex/ or config are not slowed down at all.
UI_PATHS=(
  "app"
  "components"
  "hooks"
  "lib"
  "scripts/screenshots"
  "*.css"
  "tailwind.config.*"
  "postcss.config.*"
)

staged="$(git diff --cached --name-only --diff-filter=ACMR -- "${UI_PATHS[@]}")"

if [ -z "$staged" ]; then
  exit 0
fi

# Galeri artık tek kullanımlık bir Docker yığınında üretiliyor
# (scripts/gallery/run.mjs): dakikalar sürer ve Docker ister. Bunu her UI
# commit'inde otomatik çalıştırmak commit'i kullanılamaz hale getiriyordu —
# bu yüzden hook yalnızca HATIRLATIR, commit'i bloke etmez.
if git diff --cached --name-only --diff-filter=ACMR -- docs/screenshots | grep -q .; then
  exit 0
fi

cat <<'MSG'
> UI değişikliği var ama docs/screenshots bu commit'te değil.
  Galeri eskimiş olabilir; görünüşü etkileyen bir değişiklikse:

      npm run screenshots

  (tek kullanımlık yığın kurar, birkaç dakika sürer, Docker ister)
  Bu bir uyarıdır — commit engellenmedi.
MSG
